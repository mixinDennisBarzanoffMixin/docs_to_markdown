{
  "name": "docs_to_markdown",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun index.ts",
    "cleanup:duplicates": "bun cleanup_duplicates.ts",
    "reset:failed": "bun reset_failed.ts",
    "compress:images": "bun compress_images.ts",
    "pdf:images": "bun pdf_to_images.ts",
    "reset:all": "find . -maxdepth 1 -type f -name '.docproc_state*.json' -delete && mkdir -p markdown_out documents_in && find markdown_out documents_in -mindepth 1 -maxdepth 1 -exec rm -rf {} +"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "@types/react": "^19.2.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "^4.0.1",
    "@openai/codex": "^0.141.0",
    "ai": "^6.0.3",
    "docx": "^9.5.1",
    "ink": "^6.6.0",
    "react": "^19.2.3",
    "sharp": "^0.34.5",
    "zod": "^4.2.1"
  }
}
